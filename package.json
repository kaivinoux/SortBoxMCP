{
  "name": "ia-for-everyone-sortbox-email",
  "version": "0.1.4",
  "description": "IA For EveryOne — SortBox E-Mail : application locale (Windows & Android) de tri email universel (sans IA requise, IA optionnelle et serveur MCP intégré sur PC).",
  "author": "kaivinoux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaivinoux/SortBoxMCP.git"
  },
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "cap:sync": "npm run build:renderer && cap sync android",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "imapflow": "^2.12.2",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
